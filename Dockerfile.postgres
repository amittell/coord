# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

# PostgreSQL is an explicit derivative of an already-built coord image.
# Repository and digest are separate so Docker must resolve an immutable
# reference before it can execute any base-controlled ONBUILD instruction.
ARG COORD_BASE_REPOSITORY
ARG COORD_BASE_DIGEST
FROM ${COORD_BASE_REPOSITORY}@sha256:${COORD_BASE_DIGEST}

USER root
COPY requirements-postgres.txt /tmp/requirements-postgres.txt
RUN /opt/venv/bin/pip install --no-cache-dir \
      -r /tmp/requirements-postgres.txt \
    && rm /tmp/requirements-postgres.txt
USER coord
