# Core server settings
COORD_AUTH_TOKEN=change-me
COORD_DATABASE_PATH=data/coordination.db
COORD_HOST=0.0.0.0
COORD_PORT=8080
COORD_LOG_LEVEL=info

# Optional local-only bypass. Prefer leaving this false.
COORD_ALLOW_INSECURE_NO_AUTH=false

# Optional: point at an application repo checkout for better overlap matching.
# COORD_REPO_ROOT=/absolute/path/to/your-app

# Claim sizing and cleanup
COORD_MAX_CLAIM_FILES=100
COORD_MAX_CLAIM_RATIO=0.2
COORD_CLEANUP_INTERVAL_SEC=900
COORD_DEFAULT_TTL_HOURS=4
COORD_SHARED_TTL_HOURS=2

# Rate limits (v0.30). 0 disables each knob. Limits key on the
# request-body engineer name, not the authenticated token.
# Max simultaneously active claims one engineer may hold.
COORD_MAX_CLAIMS_PER_ENGINEER=0
# Max live (waiting/in-progress) queue entries one engineer may have.
COORD_MAX_QUEUED_PER_ENGINEER=0
# Max waiting queue entries per repo before new wait_seconds requests get 429.
COORD_MAX_QUEUE_DEPTH_PER_REPO=0

# Optional: LSP-aware symbol claims (v0.31). Off by default; when
# enabled (and COORD_REPO_ROOT is set) claim-time symbol spans are
# upgraded to exact language-server ranges and symbol validation
# falls back to the LSP for names the parser cannot see. Failures
# are always silent -- the parser path is the fallback.
# COORD_LSP_ENABLED=false
# Idle language-server processes are reaped after this many seconds.
# COORD_LSP_IDLE_SHUTDOWN_SEC=300
# Per-roundtrip timeout (seconds) for any single LSP request.
# COORD_LSP_REQUEST_TIMEOUT_SEC=5.0
# Circuit breaker: consecutive failures before the (language, repo)
# circuit opens, and how long it stays open.
# COORD_LSP_CIRCUIT_FAILURE_THRESHOLD=3
# COORD_LSP_CIRCUIT_COOLDOWN_SEC=600
# Server launch commands (shlex-split, exec'd directly, no shell).
# COORD_LSP_COMMAND_PYTHON=pylsp
# COORD_LSP_COMMAND_TYPESCRIPT=typescript-language-server --stdio
# COORD_LSP_COMMAND_GO=gopls

# MCP bridge defaults
COORD_API_URL=http://127.0.0.1:8080

# Optional: OIDC SSO for the dashboard (v0.29.6). The feature turns on
# only when all four core values are set. COORD_OIDC_REDIRECT_URI must
# be the EXACT callback URL registered with your IdP.
# COORD_OIDC_ISSUER=https://idp.example.com
# COORD_OIDC_CLIENT_ID=coord-dashboard
# COORD_OIDC_CLIENT_SECRET=change-me
# COORD_OIDC_REDIRECT_URI=https://coord.example.com/auth/oidc/callback
# Which ID-token claim becomes the engineer name (default: email).
# COORD_OIDC_ENGINEER_CLAIM=email
# COORD_OIDC_SCOPES=openid email profile
# Comma-separated principals allowed to log in. REQUIRED for public
# issuers (accounts.google.com) unless you explicitly accept anyone.
# COORD_OIDC_ALLOWED_PRINCIPALS=dev@example.com,ops@example.com
# COORD_OIDC_ALLOW_ANY_PRINCIPAL=false
# Optional prefix for SSO-minted engineer names, e.g. "sso/".
# COORD_OIDC_ENGINEER_PREFIX=
