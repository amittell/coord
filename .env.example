# Core server settings
COORD_AUTH_TOKEN=change-me
COORD_DATABASE_PATH=data/coordination.db
COORD_HOST=0.0.0.0
COORD_PORT=8080
COORD_LOG_LEVEL=info

# Optional local-only bypass. Prefer leaving this false.
COORD_ALLOW_INSECURE_NO_AUTH=false

# Optional: point at an application repo checkout for better overlap matching.
# COORD_REPO_ROOT=/absolute/path/to/your-app

# Claim sizing and cleanup
COORD_MAX_CLAIM_FILES=100
COORD_MAX_CLAIM_RATIO=0.2
COORD_CLEANUP_INTERVAL_SEC=900
COORD_DEFAULT_TTL_HOURS=4
COORD_SHARED_TTL_HOURS=2

# MCP bridge defaults
COORD_API_URL=http://127.0.0.1:8080

# Optional: OIDC SSO for the dashboard (v0.29.6). The feature turns on
# only when all four core values are set. COORD_OIDC_REDIRECT_URI must
# be the EXACT callback URL registered with your IdP.
# COORD_OIDC_ISSUER=https://idp.example.com
# COORD_OIDC_CLIENT_ID=coord-dashboard
# COORD_OIDC_CLIENT_SECRET=change-me
# COORD_OIDC_REDIRECT_URI=https://coord.example.com/auth/oidc/callback
# Which ID-token claim becomes the engineer name (default: email).
# COORD_OIDC_ENGINEER_CLAIM=email
# COORD_OIDC_SCOPES=openid email profile
# Comma-separated principals allowed to log in. REQUIRED for public
# issuers (accounts.google.com) unless you explicitly accept anyone.
# COORD_OIDC_ALLOWED_PRINCIPALS=dev@example.com,ops@example.com
# COORD_OIDC_ALLOW_ANY_PRINCIPAL=false
# Optional prefix for SSO-minted engineer names, e.g. "sso/".
# COORD_OIDC_ENGINEER_PREFIX=
